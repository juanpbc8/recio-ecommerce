generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Se usará para la app (con pooler)
  directUrl = env("DIRECT_DATABASE_URL") // Se usará exclusivamente para migraciones
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum DocumentType {
  DNI
  RUC
  CE
}

// 1. CATEGORÍAS: Un solo nivel. Sin subcategorías.
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(150)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

// 2. PRODUCTOS: Control de visibilidad mediante Boolean y relación 1-a-1 con su imagen.
model Product {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  description   String   @db.Text
  slug          String   @unique @db.VarChar(255)
  isVisible     Boolean  @default(true) @map("is_visible")
  isNew         Boolean  @default(false) @map("is_new")
  isOnSale      Boolean  @default(false) @map("is_on_sale")
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @map("original_price") @db.Decimal(10, 2)

  categoryId Int              @map("category_id")
  category   Category         @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  image      ProductImage? // Relación 1-a-1: Un producto tiene una sola imagen general

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isVisible]) // Crucial para las búsquedas del Storefront
  @@index([isNew])
  @@index([isOnSale])
  @@index([categoryId])
  @@map("products")
}

// 3. VARIANTES: Manejan stock, color y talla de forma plana.
model ProductVariant {
  id    Int    @id @default(autoincrement())
  sku   String @unique @db.VarChar(100)
  stock Int    @default(0)
  color String @db.VarChar(50)
  size  String @db.VarChar(20)

  productId  Int         @map("product_id")
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([color])
  @@index([productId])
  @@map("product_variants")
}

// 4. IMÁGENES: Vinculadas directamente al producto base.
model ProductImage {
  id      Int     @id @default(autoincrement())
  url     String  @db.Text // URL de Cloudinary
  altText String? @map("alt_text") @db.VarChar(255)

  productId Int     @unique @map("product_id") // Garantiza la relación 1-a-1
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// 5. ADMINISTRADORES: Único acceso credencializado al sistema.
model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String?  @map("first_name") @db.VarChar(100)
  lastName     String?  @map("last_name") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

// 6. ÓRDENES: Diseñadas para flujo exclusivo de Invitados ("Guests").
model Order {
  id         Int         @id @default(autoincrement())
  code       String      @unique @default(uuid())
  totalPrice Decimal     @map("total_price") @db.Decimal(10, 2)
  status     OrderStatus @default(PENDIENTE)
  notes      String?     @db.Text

  customerEmail     String       @map("customer_email")
  customerFirstName String       @map("customer_first_name")
  customerLastName  String       @map("customer_last_name")
  customerDocType   DocumentType @map("customer_doc_type")
  customerDocNum    String       @map("customer_doc_num")
  customerPhone     String       @map("customer_phone") @db.VarChar(20)

  shippingAddress OrderAddress?
  items           OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerDocNum])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// 7. DIRECCIÓN DE ENVÍO: Información de entrega de la orden.
model OrderAddress {
  id               Int     @id @default(autoincrement())
  addressLine      String  @map("address_line")
  department       String  @db.VarChar(60)
  province         String  @db.VarChar(60)
  district         String  @db.VarChar(60)
  reference        String? @db.VarChar(150)
  contactFirstName String  @map("contact_first_name") @db.VarChar(100)
  contactLastName  String  @map("contact_last_name") @db.VarChar(100)
  contactPhone     String  @map("contact_phone") @db.VarChar(20)

  orderId Int   @unique @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

// 8. DETALLE DE LA ÓRDEN: Almacena los productos comprados y congela el precio histórico.
model OrderItem {
  id              Int     @id @default(autoincrement())
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(10, 2)
  quantity        Int

  orderId   Int            @map("order_id")
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId Int            @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}
